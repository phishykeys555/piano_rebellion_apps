 },
 "format": {
  "codec": "mp3 (LAME VBR -q:a 4, joint stereo)",
  "sample_rate": 44100,
  "channels": 2,
  "naming": "<drum>_<articulation>_<layer>_<roundrobin>.mp3 ; layer 1 = softest",
  "files": 215,
  "bytes": 4810756,
  "seconds": 300.1
 },
 "perspective": "as recorded in the overheads (not flipped)",
 "dynamics": {
  "note": "Layers keep the level and brightness the drummer produced: files of softer layers are quieter and darker. Every articulation is normalised so its loudest layer peaks at -1 dBFS (cymbals -3 dBFS); all layers and round robins of an articulation share one mix. stored_rel_db is the level of a layer in the files relative to the loudest layer; natural_rel_db is what was recorded. They differ only where the natural range was wider than 24 dB (softest layers lifted proportionally); gain_trim_db (= natural - stored, zero or negative) restores the recorded level. Do NOT add a full velocity-to-gain law on top: pick the layer by velocity, then scale gain only inside the layer range (about +/-2 dB).",
  "art_rel_db": "natural level of the loudest layer of an articulation relative to the main articulation of the same drum (files are normalised, apply this to restore e.g. a quieter cross-stick)",
  "overhead_balance_db": "level of the drum in the overhead pair relative to snare centre, loudest layer; a starting point for the kit balance, not applied to the files",
  "velocity": "vel_lo/vel_hi follow the recorded level steps: the softest layer is centred near velocity 26, the loudest at 127, split points at the geometric mean of neighbouring layers; remap freely"
 },
 "processing": {
  "steps": [
   "multi-mic stems summed to stereo with the gains in mix (dB, relative to the reference mic; computed so each mic contributes recipe dB relative to the reference on the loudest layer)",
   "close mono mics panned to the position the drum has in the overhead image; polarity of shell close mics flipped when that gives more low end against the overheads",
   "start trimmed to 1.5 ms before the onset, 0.7 ms fade-in",
   "tail cut 60 dB under the loudest hit of the articulation or at max_len_s, cos^2 fade-out",
   "no EQ, no compression, no reverb, no pitch change",
   "TPDF dither to 16 bit, LAME VBR"
  ],
